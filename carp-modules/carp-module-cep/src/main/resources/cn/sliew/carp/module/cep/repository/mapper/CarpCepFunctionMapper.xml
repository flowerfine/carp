<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sliew.carp.module.cep.repository.mapper.CarpCepFunctionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.sliew.carp.module.cep.repository.entity.CarpCepFunction">
        <result column="id" property="id" />
        <result column="creator" property="creator" />
        <result column="create_time" property="createTime" />
        <result column="editor" property="editor" />
        <result column="update_time" property="updateTime" />
        <result column="namespace" property="namespace" />
        <result column="name" property="name" />
        <result column="short_name" property="shortName" />
        <result column="uuid" property="uuid" />
        <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        creator,
        create_time,
        editor,
        update_time,
        namespace, `name`, short_name, uuid, remark
    </sql>

    <select id="page" resultMap="BaseResultMap">
        select
        *
        from
        (
        select
        t1.*
        from
        `carp_cep_function` t1
        join `carp_cep_function_category_relation` t2 on t1.id = t2.function_id
        <where>
            <if test="namespace != null and namespace != ''">
                AND t1.`namespace` = #{namespace}
            </if>
            <if test="categoryId != null">
                AND t2.id = #{categoryId}
            </if>
        </where>
        group by
        t1.id
        ) as t
        order by
        t.id desc
    </select>

</mapper>
